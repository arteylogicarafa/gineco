# ---------------------------------------------------------------
# Historia Clinica Ginecologica - Configuracion
# Copia este archivo como .env y completa los valores.
# ---------------------------------------------------------------

# Base de datos PostgreSQL (Neon en produccion, local en desarrollo)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gineco
DB_USER=postgres
DB_PASSWORD=
# Neon requiere sslmode=require | local: disable
DB_SSLMODE=disable

# URL publica de la aplicacion (sin slash final)
# Local XAMPP: http://localhost/gineco
APP_URL=http://localhost/gineco

# files = guarda imagenes en public/uploads (recomendado en servidor con disco)
# db    = guarda imagenes en base64 dentro de PostgreSQL (ideal para Vercel/serverless)
UPLOAD_MODE=files

# 1 = muestra errores detallados (solo desarrollo), 0 en produccion
APP_DEBUG=1

# Nombre de la cookie de sesion
SESSION_NAME=gineco_session
